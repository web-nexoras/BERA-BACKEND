# =============================================================================
# NEXORA FASHIONS BACKEND — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values before running the app.
# Never commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_NAME=Nexora Fashions Backend
APP_URL=http://localhost:5000
FRONTEND_URL=https://quick-sell-bd.vercel.app

# -----------------------------------------------------------------------------
# MONGODB
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Example for local: mongodb://localhost:27017/nexora-fashions

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# For Redis Cloud / Upstash:
# REDIS_URL=redis://:<password>@<host>:<port>

# Redis Cache TTL (in seconds)
REDIS_CACHE_TTL_PRODUCTS=3600
REDIS_CACHE_TTL_CATEGORIES=7200
REDIS_CACHE_TTL_FEATURED=1800
REDIS_CACHE_TTL_BESTSELLERS=3600

# -----------------------------------------------------------------------------
# CLOUDINARY (Image Upload)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# EMAIL — BREVO (Sendinblue)
# -----------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_NAME=Nexora Fashions
EMAIL_FROM_ADDRESS=noreply@nexorafashions.com
EMAIL_SUPPORT_ADDRESS=support@nexorafashions.com

# -----------------------------------------------------------------------------
# SSLCOMMERZ (Payment Gateway)
# -----------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASS=your_sslcommerz_store_password
SSLCOMMERZ_IS_LIVE=false
# Set to true in production

# SSLCommerz Callback URLs
SSLCOMMERZ_SUCCESS_URL=http://localhost:5000/api/v1/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:5000/api/v1/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5000/api/v1/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/sslcommerz/ipn

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# OTP / PASSWORD RESET
# -----------------------------------------------------------------------------
OTP_EXPIRES_IN_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30

# -----------------------------------------------------------------------------
# SHIPPING (Bangladesh)
# -----------------------------------------------------------------------------
SHIPPING_CHARGE_INSIDE_DHAKA=60
SHIPPING_CHARGE_OUTSIDE_DHAKA=120

# -----------------------------------------------------------------------------
# ORDER MANAGEMENT
# -----------------------------------------------------------------------------
# Time in minutes before an unpaid order is automatically cancelled
UNPAID_ORDER_CANCEL_MINUTES=30

# -----------------------------------------------------------------------------
# ADMIN
# -----------------------------------------------------------------------------
ADMIN_DEFAULT_EMAIL=admin@nexorafashions.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPassword123!

# -----------------------------------------------------------------------------
# CRON JOB SCHEDULES (cron expressions)
# -----------------------------------------------------------------------------
CRON_ORDER_CLEANUP=*/15 * * * *
CRON_COUPON_EXPIRY=0 0 * * *
CRON_INVENTORY_ALERT=0 8 * * *
CRON_DAILY_REPORT=0 23 * * *
CRON_CLEAR_OTPS=0 */2 * * *
CRON_TIMEZONE=Asia/Dhaka

# -----------------------------------------------------------------------------
# SWAGGER / API DOCS
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true
# Set to false in production if you don't want public API docs

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
# Options: error, warn, info, http, debug

# -----------------------------------------------------------------------------
# BCRYPT
# -----------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
